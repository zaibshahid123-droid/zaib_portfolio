# Copy this file to .env and fill in real values. Never commit the real .env.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,your-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app

# Leave DATABASE_URL empty to use local sqlite.
# For Postgres (Render, Railway, Supabase, Neon, etc.):
DATABASE_URL=

# Gmail example: use a 16-character App Password, not your normal password.
# https://myaccount.google.com/apppasswords
